{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    { "source": "/downloads/nearwork.apk", "headers": [
      { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
      { "key": "Content-Disposition", "value": "attachment; filename=\"nearwork.apk\"" },
      { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
    ] }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://nearwork-api.vercel.app/api/:path*" },
    { "source": "/((?!api/|downloads/).*)", "destination": "/index.html" }
  ]
}
