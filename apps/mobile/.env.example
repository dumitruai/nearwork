# Public, embedded in the bundle. Never put secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:3000
# Only needed when a hosted HTTP proxy cannot forward WebSocket upgrades.
# Point this to the same API server, e.g. https://nearwork-api.vercel.app.
# VITE_REALTIME_URL=
# Optional Photon-compatible geocoding endpoint (public URL, no secret).
VITE_GEOCODING_URL=https://photon.komoot.io/api/
