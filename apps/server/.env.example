# Local development. Generate a unique secret before deployment.
DATABASE_URL=postgresql://nearwork:nearwork@localhost:5432/nearwork
REDIS_URL=redis://localhost:6379
REALTIME_SECRET=local-realtime-only-change-this-secret-32chars
BETTER_AUTH_SECRET=local-development-only-change-this-secret-32chars
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost,https://localhost
ENABLE_LOCATION_MOCKS=true
ENABLE_APPLICANT_BOTS=true
# Optional: without a key, test applicants use scripted replies.
XAI_API_KEY=
XAI_MODEL=grok-build-0.1
