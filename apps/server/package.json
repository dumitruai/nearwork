{
  "name": "@nearwork/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#server/*": "./src/lib/server/*.ts"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "preview": "npm run start",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:refresh-generated": "node --env-file-if-exists=.env --import tsx scripts/refresh-generated.ts",
    "test": "node --env-file-if-exists=.env --import tsx --test tests/*.test.ts",
    "start": "node --env-file-if-exists=.env --import tsx start.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "redis": "^6.3.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.4",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tsx": "^4.23.15",
    "vite": "^8.3.4"
  }
}
